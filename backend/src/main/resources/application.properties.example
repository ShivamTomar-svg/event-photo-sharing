# ========================================================
# Momento Backend - Application Properties Configuration Template
# ========================================================

spring.application.name=event-photo-sharing
server.port=8085

# MySQL Database Configuration
# In Railway production, these are populated via:
# 1. SPRING_DATASOURCE_URL
# 2. Or Railway service references: ${{MySQL.MYSQLHOST}}, ${{MySQL.MYSQLPORT}}, etc.
# 3. Or Railway MYSQL_URL: ${{MySQL.MYSQL_URL}}
spring.datasource.url=jdbc:mysql://localhost:3306/event_photo_sharing?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=your_mysql_username
spring.datasource.password=your_mysql_password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate Configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.format_sql=true

# JWT Security Configuration
app.jwt.secret=Your_Strong_JWT_Secret_Key_Minimum_256_Bits
app.jwt.expiration-ms=86400000

# File Upload Limit Configuration
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Logging Configuration
logging.level.com.eventshare=INFO
logging.level.org.springframework.security=WARN
